# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/tradecoach_db
PGHOST=localhost
PGPORT=5432
PGDATABASE=tradecoach_db
PGUSER=username
PGPASSWORD=password

# Session Configuration
SESSION_SECRET=your-super-secret-session-key-change-in-production

# Server Configuration
NODE_ENV=development
PORT=5000

# AI Integration (Optional - for future OpenAI integration)
# OPENAI_API_KEY=sk-your-openai-api-key-here

# Stripe Integration (Optional - for future payment integration)
# STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
# STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
# STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# Email Configuration (Optional - for future email notifications)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password

# File Upload Configuration
MAX_FILE_SIZE=5242880

# Frontend URL (for CORS and redirects)
# FRONTEND_URL=http://localhost:5000
FRONTEND_URL=https://chatmind-m2rf.onrender.com
VITE_API_BASE_URL=https://chatmind-m2rf.onrender.com

# Replit Environment (automatically set in Replit)
# REPL_ID=your-repl-id
# REPLIT_DOMAINS=your-repl-domain.replit.dev

# Development flags
ENABLE_LOGGING=true
ENABLE_CORS=true
